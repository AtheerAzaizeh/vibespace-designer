{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VibeSpace catalog",
  "type": "object",
  "required": ["currency", "price_checked_at", "stores", "categories", "styles"],
  "properties": {
    "currency": { "const": "ILS" },
    "price_checked_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "stores": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "home", "commission_rate"],
        "properties": {
          "name": { "type": "string" },
          "domain": { "type": "string" },
          "home": { "type": "string", "format": "uri" },
          "commission_rate": { "type": "number", "minimum": 0, "maximum": 1 },
          "commission_note": { "type": "string" }
        }
      }
    },
    "categories": { "type": "object", "additionalProperties": { "type": "string" } },
    "styles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "paletteName", "glow", "floor", "desk", "palette", "analysis", "light", "layout", "products"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+$" },
          "palette": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "array", "items": [{ "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, { "type": "string" }] } },
          "products": {
            "type": "array", "minItems": 8,
            "items": {
              "type": "object",
              "required": ["sku", "cat", "name", "store", "price", "url"],
              "properties": {
                "sku": { "type": "string" },
                "cat": { "type": "string" },
                "name": { "type": "string", "minLength": 4 },
                "store": { "type": "string" },
                "price": { "type": "number", "exclusiveMinimum": 0 },
                "list_price": { "type": "number", "exclusiveMinimum": 0 },
                "url": { "type": "string", "pattern": "^https://www\\.(ikea\\.com/il/he/p/|foxhome\\.co\\.il/products/|homecenter\\.co\\.il/products/)" },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
